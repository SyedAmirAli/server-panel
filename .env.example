# ─── Docker Compose (mysql service) ───────────────────────────────
MYSQL_ROOT_PASSWORD=12345678
MYSQL_DATABASE=appszone_mail
MYSQL_USER=appszone
MYSQL_PASSWORD=12345678

# ─── API (apps/api) ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4010

# Database — use `localhost` for native MySQL; `mysql` when running via docker compose.
DATABASE_URL=mysql://appszone:12345678@localhost:3306/appszone_mail
# Shadow DB used by `prisma migrate dev` (so the app user needs no global grant)
SHADOW_DATABASE_URL=mysql://appszone:12345678@localhost:3306/appszone_mail_shadow
# Docker compose example:
# DATABASE_URL=mysql://appszone:12345678@mysql:3306/appszone_mail
# SHADOW_DATABASE_URL=mysql://appszone:12345678@mysql:3306/appszone_mail_shadow

# Admin auth
ADMIN_PASSWORD=change-me-strong-admin-password
JWT_SECRET=change-me-long-random-jwt-secret
JWT_EXPIRES_IN=24h

# API key hashing pepper (HMAC-SHA256). Rotate carefully — invalidates all keys.
API_KEY_PEPPER=change-me-long-random-pepper

# Mailbox credential encryption (AES-256-GCM, 32-byte key, hex or base64)
ENCRYPTION_KEY=change-me-32-byte-hex-key

# CORS (only needed for cross-origin API-key clients; the SPA is same-origin)
CORS_ORIGIN=http://localhost:5173

# Dev: Nest proxies non-API routes to the Vite dev server (HMR included).
WEB_DEV_SERVER_URL=http://localhost:5173

# Default SMTP (Mailcow) — used by send worker if mailbox-level creds absent
SMTP_HOST=mail.appszonebd.com
SMTP_PORT=587
SMTP_USER=noreply@appszonebd.com
SMTP_PASSWORD=change-me
# Set to false ONLY to bypass an expired/self-signed mail-server cert in dev (insecure)
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ─── Web (apps/web) — build-time, exposed to client ───────────────
# Leave empty for same-origin: the SPA calls /api/v1/* on the Nest server.
# Set a full URL (e.g. https://api.host/api/v1) only for a split-origin deploy.
VITE_API_BASE_URL=

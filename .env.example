# ═══════════════════════════════════════════════════════════════════
# AppsZone Mail — template for the single .env at the repo root.
#
#   cp .env.example .env
#
# One file serves everything:
#   • apps/api  — ConfigModule resolves it from the repo root, so it applies
#                 whether Nest runs from apps/api (dev) or /app (docker).
#   • apps/web  — Vite reads it via `envDir` and exposes only VITE_* to the client.
#   • docker    — compose passes it to the container as env_file.
#
# NODE_ENV is deliberately not here: `start:prod` and the Dockerfile set it, and a
# file that can silently flip the app into production mode is a footgun.
# The container has no entrypoint script and never syncs the schema on startup —
# run `yarn docker:db:migrate` when a deploy needs migrations applied.
# ═══════════════════════════════════════════════════════════════════

# ─── API (apps/api) ───────────────────────────────────────────────
API_PORT=4010
API_HOST=0.0.0.0

# ─── Database (PostgreSQL) ────────────────────────────────────────
# No shadow database: this project uses the offline `migrate diff` -> `migrate
# deploy` workflow, which does not need one. URL-encode special characters in the
# password (e.g. `@` -> `%40`).
PG_USER=appszone
PG_PASSWORD=change-me
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=apz_mailserver
DATABASE_URL="postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}?schema=public"

# ─── Queue ────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://appszone:appszone_dev@localhost:5672

# ─── Admin auth ───────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# API key hashing pepper (HMAC-SHA256). Rotate carefully — invalidates all keys.
# openssl rand -hex 32
API_KEY_PEPPER=

# Mailbox credential encryption (AES-256-GCM, 32-byte key, hex or base64)
ENCRYPTION_KEY=

# ─── HTTP ─────────────────────────────────────────────────────────
# CORS is only needed for cross-origin API-key clients; the SPA is same-origin.
CORS_ORIGIN=http://localhost:5173
# Dev: Nest proxies non-API routes to the Vite dev server (HMR included).
WEB_DEV_SERVER_URL=http://localhost:5173

# ─── SMTP (Mailcow) ───────────────────────────────────────────────
# Used by the send worker when mailbox-level credentials are absent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=false

# ─── AI gateway (OpenAI-compatible) ───────────────────────────────
AI_BASE_URL=
AI_API_KEY=
# Default model when a caller specifies none (overridable per-setting in the UI).
AI_DEFAULT_MODEL=auto/best-fast
# Vision model used to read text out of uploaded images (AI Studio OCR).
OCR_MODEL=auto/best-fast

# ─── Job Finder ───────────────────────────────────────────────────
# Read-only source for the candidate profile; never written to.
RESUME_SOURCE_PATH=
# Adzuna is scaffolded but stays disabled until these are set (developer.adzuna.com).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── Cloudflare R2 ────────────────────────────────────────────────
# Object storage for AI Studio documents and attachments.
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_BUCKET_FOLDER=

# ─── Web (apps/web) — build-time, exposed to the client ───────────
# Leave empty for same-origin (SPA served by the Nest server). Set only for a
# split-origin deploy where the API lives on a different host.
VITE_API_BASE_URL=

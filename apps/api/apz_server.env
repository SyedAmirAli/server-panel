# ─── API (apps/api) ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4010
API_HOST=0.0.0.0

# Database (MySQL)
DATABASE_URL=mysql://appszone:12345678@localhost:3306/appszone_mail
SHADOW_DATABASE_URL=mysql://appszone:12345678@localhost:3306/appszone_mail_shadow

# RabbitMQ
RABBITMQ_URL=amqp://appszone:appszone_dev@localhost:5672

# Admin auth
ADMIN_PASSWORD=12345678
JWT_SECRET=e1af544080f82c784f187bde42ba9f920d70283c077fd687e7a307dae68a77be
JWT_EXPIRES_IN=24h

# API key hashing pepper (HMAC-SHA256). Rotate carefully — invalidates all keys.
API_KEY_PEPPER=1ae4c3568ef827f5802c2fce864b10c9c4ba9289c8eabc1a41e066cc7bc28f29

# Mailbox credential encryption (AES-256-GCM, 32-byte key, hex or base64)
ENCRYPTION_KEY=SONYqh9dWQadVfwr9mDVOTLGUb2OvvUvtuvuT445

# CORS (only needed for cross-origin API-key clients; the SPA is same-origin)
CORS_ORIGIN=http://localhost:5173

# ─── Storage (SWS S3-compatible file manager) ─────────────────────
# Bucket credentials are encrypted at rest with ENCRYPTION_KEY (above).
# Temp dir for building ZIP archives (folder/whole-bucket downloads).
STORAGE_ZIP_TMP_DIR=
# Hard cap for a single ZIP job (bytes). Default 2 GiB.
STORAGE_ZIP_MAX_BYTES=2147483648
# Default presigned-URL lifetime (seconds) for private objects.
STORAGE_PRESIGN_DEFAULT_TTL=3600

# Dev: Nest proxies non-API routes to the Vite dev server (HMR included).
WEB_DEV_SERVER_URL=http://localhost:5173

# Default SMTP (Mailcow) — used by send worker if mailbox-level creds absent
SMTP_HOST=mail.appszonebd.com
SMTP_PORT=465
SMTP_USER=sales@appszonebd.com
SMTP_PASSWORD=Siy@mcse@75

# ─── Web (apps/web) — build-time, exposed to client ───────────────
# Leave empty for same-origin (SPA served by the Nest server). Set only for a
# split-origin deploy where the API lives on a different host.
VITE_API_BASE_URL=
SMTP_TLS_REJECT_UNAUTHORIZED=false
